# ============================================================
# MEP-PMS — متغیرهای محیطی
# این فایل را به .env کپی کنید:  cp .env.example .env
# ============================================================

# ---------- اجرای محلی (SQLite) ----------
DATABASE_URL="file:./db/custom.db"

# ---------- تولید (Production) روی Vercel + Supabase ----------
# مقادیر زیر را در Vercel > Project > Settings > Environment Variables وارد کنید.
# از Supabase > Connect (بالا-راست داشبورد) رشته اتصال را کپی کنید.

# ۱) اتصال Pooling (حالت Transaction — برای اپلیکیشن روی Vercel)
#    پسورد دیتابیس را از Supabase > Project Settings > Database بگیرید.
# DATABASE_URL="postgresql://postgres.kioqbtldumiuwkfdclhn:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ۲) اتصال مستقیم (برای مهاجرت/سید — اختیاری)
# DIRECT_URL="postgresql://postgres.kioqbtldumiuwkfdclhn:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# کلیدهای ساپابیس (فقط اگر بخواهید مستقیماً از REST API ساپابیس استفاده کنید)
# NEXT_PUBLIC_SUPABASE_URL="https://kioqbtldumiuwkfdclhn.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."   ← هرگز در گیت/کلاینت قرار ندهید
